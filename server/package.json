{
  "name": "hornsphere-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:smoke": "tsx tests/smoke-test.ts",
    "test:content": "tsx tests/content-sanitization.ts",
    "seed": "tsx src/seed.ts",
    "admin:create": "tsx src/create-admin.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongoose": "^9.10.3",
    "sanitize-html": "^2.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/sanitize-html": "^2.16.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
